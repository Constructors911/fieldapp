{
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/uploads/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/clock-out-reminders", "schedule": "*/15 * * * *" }
  ]
}
